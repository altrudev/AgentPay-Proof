# AgentPay Proof environment template
# Never commit a funded private key. AgentPay does not need one.

# Required only for explicit LIVE browser-wallet mode.
BASE_RPC_URL=
AGENTPAY_CHAIN_ID=8453
AGENTPAY_USDC_ADDRESS=
AGENTPAY_RECIPIENT_ADDRESS=
AGENTPAY_MAX_AMOUNT_ATOMIC=1000000
AGENTPAY_STATE_DB=agentpay-state/live.sqlite3

# Signing/broadcast happens in the operator-controlled browser wallet.
# The server prepares one exact governed transaction and independently
# reconciles the returned hash against Base RPC evidence.
